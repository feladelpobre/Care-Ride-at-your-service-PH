# Copy to .env.local and fill in. Never commit real values.
# Required for the AI feature: an OpenAI key (sk-...) or an OpenRouter key (sk-or-...)
OPENAI_API_KEY=
# Optional: override the API base URL (auto-set to https://openrouter.ai/api/v1 for sk-or- keys)
OPENAI_BASE_URL=
# Optional (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional: without these, bookings are kept in memory (demo mode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: email notifications (booking confirmation + 2-hour reminder).
# Gmail: turn on 2-Step Verification, create an App Password, use it as SMTP_PASS. Never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Protects /api/reminders (called every 10 minutes by Supabase pg_cron). Long random string.
CRON_SECRET=
# Admin login for the dispatcher board (log in at /admin/login). Without both, the board stays closed.
# Changing the password logs everyone out.
DISPATCH_USER=
DISPATCH_PASSWORD=
# Optional: staff work emails that may log in with an emailed 15-minute link if they forget the password
# (comma-separated). Needs the SMTP settings above. Example: dispatcher1@yourdomain.ph, dispatcher2@yourdomain.ph
DISPATCH_STAFF_EMAILS=
# "I am human" check before the app opens (Cloudflare Turnstile, free: dash.cloudflare.com > Turnstile > Add widget).
# The site key is public; the secret key is server-only and also signs the 24-hour cookie.
# Without both, the check is switched off. Local testing keys that always pass:
#   site 1x00000000000000000000AA · secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
