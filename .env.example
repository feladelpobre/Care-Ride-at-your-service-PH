# Copy to .env.local and fill in. Never commit real values.
# Required for the AI feature: an OpenAI key (sk-...) or an OpenRouter key (sk-or-...)
OPENAI_API_KEY=
# Optional: override the API base URL (auto-set to https://openrouter.ai/api/v1 for sk-or- keys)
OPENAI_BASE_URL=
# Optional (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional: without these, bookings are kept in memory (demo mode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: email notifications (booking confirmation + 2-hour reminder).
# Gmail: turn on 2-Step Verification, create an App Password, use it as SMTP_PASS. Never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Protects /api/reminders (called every 10 minutes by Supabase pg_cron). Long random string.
CRON_SECRET=
# Admin login for the dispatcher board (/dispatch). Without both, the board stays closed.
DISPATCH_USER=
DISPATCH_PASSWORD=
